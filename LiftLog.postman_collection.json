{
	"info": {
		"_postman_id": "748d538d-8a4b-4b14-8f0a-84518776077a",
		"name": "LiftLog API",
		"description": "API collection for the LiftLog workout tracker school project.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Workout Sessions",
			"item": [
				{
					"name": "Start Session",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const jsonData = pm.response.json();",
									"if (jsonData.id) {",
									"    pm.collectionVariables.set(\"lastSessionId\", jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"split\": \"FULL_BODY\",\n    \"name\": \"Morning Power\",\n    \"note\": \"First test in Postman\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/sessions",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"sessions"
							]
						},
						"description": "Starts a new active session. Automatically saves the ID to collection variables."
					},
					"response": []
				},
				{
					"name": "List All Sessions",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/sessions",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"sessions"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Session Detail",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/sessions/{{lastSessionId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"sessions",
								"{{lastSessionId}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "Update Session",
					"request": {
						"method": "PUT",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Updated Name\",\n    \"note\": \"Added a note later\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/sessions/{{lastSessionId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"sessions",
								"{{lastSessionId}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "Finish Session",
					"request": {
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/sessions/{{lastSessionId}}/finish",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"sessions",
								"{{lastSessionId}}",
								"finish"
							]
						},
						"description": "Calculates duration and sets status to FINISHED."
					},
					"response": []
				},
				{
					"name": "Delete Session",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/sessions/{{lastSessionId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"sessions",
								"{{lastSessionId}}"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Exercise Entries",
