									"    pm.collectionVariables.set(\"lastExerciseId\", jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"exerciseKey\": \"bench-press\",\n    \"sets\": 3,\n    \"reps\": 10,\n    \"weight\": 80,\n    \"rpe\": 8,\n    \"note\": \"Felt strong\"\n}",
							"options": {
